---
import Base from '../layouts/Base.astro';
import { GLOSSARIO } from '../dados/glossario';
const termos = [...GLOSSARIO].sort((a, b) => a.termo.localeCompare(b.termo, 'pt-BR'));
---
<Base titulo="Glossário · A Casa do Cais">
  <main class="envoltorio">
    <h1>Glossário</h1>
    <p class="subtitulo">Só aparece o que você já leu. Um leitor no Capítulo 2 e outro no 40 veem mundos diferentes.</p>
    <dl>
      {termos.map((t) => (
        <div class="cartao verbete" data-revela={t.revelaEm}>
          <dt>{t.termo}</dt>
          <dd class="conteudo-trancado">{t.definicao}</dd>
          <p class="cadeado subtitulo" hidden>destrava no Capítulo {t.revelaEm}</p>
        </div>
      ))}
    </dl>
  </main>
  <script>
    import { progresso } from '../scripts/progresso';
    const lido = progresso.ler();
    document.querySelectorAll<HTMLElement>('.verbete').forEach((v) => {
      if (Number(v.dataset.revela) > lido) {
        v.classList.add('trancado');
        v.querySelector<HTMLElement>('.cadeado')!.hidden = false;
      }
    });
  </script>
  <style>
    main { padding-block: 1.5rem 3rem; }
    dl { margin: 1.5rem 0 0; display: grid; gap: 0.7rem; }
    dt { font-family: var(--serifa); font-size: 1.05rem; margin-bottom: 0.3rem; }
    dd { margin: 0; font-size: 0.92rem; line-height: 1.6; color: var(--tinta-fraca); }
    .cadeado { margin: 0.5rem 0 0; font-size: 0.72rem; letter-spacing: 0.08em; }
  </style>
</Base>
