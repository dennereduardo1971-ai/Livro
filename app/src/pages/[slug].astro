---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mapa from '../componentes/Mapa.astro';
import { listarCapitulos } from '../dados/capitulos';

export async function getStaticPaths() {
  const capitulos = await listarCapitulos();
  return capitulos.map((c, i) => ({
    params: { slug: c.slug },
    props: { capitulo: c, anterior: capitulos[i - 1] ?? null, proximo: capitulos[i + 1] ?? null },
  }));
}

const { capitulo, anterior, proximo } = Astro.props;
const { Content } = await render(capitulo.entrada);
---
<Base titulo={`${capitulo.titulo} · A Casa do Cais`} barra={false}>
  <div class="progresso"><div class="preenchimento"></div></div>

  <nav class="barra">
    <a class="marca" href="/capitulos">‹ capítulos</a>
    <button id="tipografia" aria-label="Tipografia e tema">Aa</button>
  </nav>

  <div id="painel-tipografia" hidden>
    <div class="grupo">
      <span>corpo</span>
      <button data-fonte="-" aria-label="Diminuir fonte">A−</button>
      <button data-fonte="+" aria-label="Aumentar fonte">A+</button>
    </div>
    <div class="grupo">
      <span>luz</span>
      <button data-tema="claro">claro</button>
      <button data-tema="escuro">escuro</button>
      <button data-tema="vela">vela</button>
    </div>
  </div>

  <aside class="aviso cartao" hidden>
    <p>
      Este livro trata de sofrimento psíquico — presenças, desespero por dívida,
      soterramento — sem termos clínicos e sem sensacionalismo.
      Se precisar conversar, o CVV atende no <a href="tel:188">188</a>, 24 horas.
    </p>
    <button class="entendi">entendi</button>
  </aside>

  <main class="leitura" data-numero={capitulo.numero}>
    <article><Content /></article>

    <nav class="fim">
      {anterior && <a href={`/${anterior.slug}`}>‹ {anterior.titulo}</a>}
      {proximo
        ? <a class="proximo" href={`/${proximo.slug}`}>{proximo.titulo} ›</a>
        : <span class="subtitulo">Fim do que está publicado. O próximo desce o rio na semana que vem.</span>}
    </nav>
  </main>

  <button id="abrir-mapa" aria-label="Ver o mapa" title="Ver o mapa">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M9 4 3 6.5v13L9 17l6 2.5 6-2.5v-13L15 7 9 4Z" stroke-linejoin="round" />
      <path d="M9 4v13M15 7v12.5" />
    </svg>
  </button>

  <div id="gaveta-mapa" hidden>
    <button class="fechar-gaveta" aria-label="Fechar mapa">✕</button>
    <Mapa modo="flutuante" />
  </div>

  <script>
    import { progresso, marcador, tema, fonte } from '../scripts/progresso';

    const main = document.querySelector<HTMLElement>('.leitura')!;
    const numero = Number(main.dataset.numero);
    const barra = document.querySelector<HTMLElement>('.progresso .preenchimento')!;

    /* --- progresso e marcador ------------------------------------- */
    const fracao = () => {
      const total = document.documentElement.scrollHeight - innerHeight;
      return total > 0 ? Math.min(1, Math.max(0, scrollY / total)) : 0;
    };
    let guardando: number | undefined;
    addEventListener('scroll', () => {
      const f = fracao();
      barra.style.transform = `scaleX(${f})`;
      if (f > 0.92) progresso.concluir(numero);
      clearTimeout(guardando);
      guardando = setTimeout(() => marcador.guardar(`capitulo-${numero}`, f), 400) as unknown as number;
    }, { passive: true });

    const salvo = marcador.ler(`capitulo-${numero}`);
    if (salvo > 0.02 && salvo < 0.98) {
      addEventListener('load', () => {
        scrollTo({ top: salvo * (document.documentElement.scrollHeight - innerHeight), behavior: 'instant' as ScrollBehavior });
      });
    }

    /* --- aviso de conteúdo (uma vez) ------------------------------- */
    const aviso = document.querySelector<HTMLElement>('.aviso')!;
    try {
      if (!localStorage.getItem('cais:aviso')) aviso.hidden = false;
    } catch {}
    aviso.querySelector('.entendi')!.addEventListener('click', () => {
      aviso.hidden = true;
      try { localStorage.setItem('cais:aviso', '1'); } catch {}
    });

    /* --- tipografia ------------------------------------------------ */
    const painel = document.getElementById('painel-tipografia')!;
    document.getElementById('tipografia')!.addEventListener('click', () => {
      painel.hidden = !painel.hidden;
    });
    painel.querySelectorAll<HTMLButtonElement>('[data-fonte]').forEach((b) =>
      b.addEventListener('click', () => fonte.aplicar(fonte.ler() + (b.dataset.fonte === '+' ? 1 : -1))),
    );
    painel.querySelectorAll<HTMLButtonElement>('[data-tema]').forEach((b) =>
      b.addEventListener('click', () => tema.aplicar(b.dataset.tema as any)),
    );

    /* --- o brilho segue a posição de leitura ----------------------- */
    const ancoras = [...document.querySelectorAll<HTMLElement>('.ancora-cena')];
    if (ancoras.length) {
      let atual = '';
      const anunciar = (a: HTMLElement) => {
        if (a.id === atual) return;
        atual = a.id;
        dispatchEvent(new CustomEvent('cena', {
          detail: {
            lugar: a.dataset.lugar,
            tensao: a.dataset.tensao || 'media',
            tempo: a.dataset.tempo || 'agora',
          },
        }));
      };
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) if (e.isIntersecting) anunciar(e.target as HTMLElement);
        },
        { rootMargin: '-25% 0px -60% 0px' },
      );
      ancoras.forEach((a) => observador.observe(a));
      anunciar(ancoras[0]);
    }

    /* --- gaveta do mapa: só sob demanda ---------------------------- */
    const gaveta = document.getElementById('gaveta-mapa')!;
    document.getElementById('abrir-mapa')!.addEventListener('click', () => {
      gaveta.hidden = false;
      requestAnimationFrame(() => gaveta.classList.add('aberta'));
    });
    gaveta.querySelector('.fechar-gaveta')!.addEventListener('click', () => {
      gaveta.classList.remove('aberta');
      setTimeout(() => (gaveta.hidden = true), 500);
    });
  </script>

  <style is:global>
    .leitura article {
      max-width: var(--largura-leitura);
      margin: 0 auto;
      padding: 1.5rem 1.35rem 3rem;
      font-family: var(--serifa);
      font-size: var(--tamanho-leitura);
      line-height: var(--altura-leitura);
      hanging-punctuation: first;
    }
    .leitura h1 {
      font-size: 1.5rem; font-weight: 500; letter-spacing: 0.06em;
      text-transform: lowercase; color: var(--tinta-fraca);
      margin: 0 0 2.5rem; text-align: center;
      font-variant: small-caps;
    }
    .leitura h2 {
      font-size: 1.05rem; font-weight: 500; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--tinta-fraca);
      margin: 3rem 0 1.6rem; text-align: center;
    }
    .leitura p { margin: 0 0 1.15em; text-wrap: pretty; }
    .leitura p + p { text-indent: 1.3em; }
    .leitura h2 + p, .leitura h1 + p { text-indent: 0; }
    .leitura em { font-style: italic; }
    .leitura hr {
      border: 0; margin: 2.4rem auto; width: 5rem;
      border-top: 1px solid var(--borda);
    }
  </style>

  <style>
    .progresso {
      position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 50;
      background: transparent;
    }
    .preenchimento {
      height: 100%; background: var(--realce); transform: scaleX(0);
      transform-origin: 0 50%; transition: transform 120ms linear;
    }
    #painel-tipografia[hidden] { display: none; }
    #painel-tipografia {
      position: sticky; top: 44px; z-index: 41;
      display: flex; flex-wrap: wrap; gap: 1.2rem; justify-content: center;
      padding: 0.7rem 1rem; border-bottom: 1px solid var(--borda);
      background: var(--fundo-alto);
    }
    #painel-tipografia .grupo { display: flex; align-items: center; gap: 0.4rem; }
    #painel-tipografia span {
      font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--tinta-fraca);
    }
    #painel-tipografia button {
      font: inherit; font-size: 0.8rem; padding: 0.2rem 0.6rem;
      background: none; color: var(--tinta); border: 1px solid var(--borda);
      border-radius: 999px; cursor: pointer;
    }
    #painel-tipografia button:hover { border-color: var(--realce); }

    .aviso {
      max-width: var(--largura-leitura); margin: 1rem auto 0; font-size: 0.86rem;
      display: flex; gap: 1rem; align-items: center;
    }
    .aviso p { margin: 0; line-height: 1.5; }
    .aviso .entendi {
      font: inherit; font-size: 0.78rem; white-space: nowrap; cursor: pointer;
      background: none; border: 1px solid var(--borda); border-radius: 999px;
      padding: 0.3rem 0.75rem; color: var(--tinta);
    }

    .fim {
      max-width: var(--largura-leitura); margin: 0 auto; padding: 2rem 1.35rem 0;
      border-top: 1px solid var(--borda);
      display: flex; justify-content: space-between; gap: 1rem; font-size: 0.85rem;
    }
    .fim a { text-decoration: none; color: var(--tinta-fraca); }
    .fim a:hover { color: var(--realce); }
    .fim .proximo { margin-left: auto; }

    #abrir-mapa {
      position: fixed; right: 1rem; bottom: 1.2rem; z-index: 45;
      width: 46px; height: 46px; border-radius: 50%;
      display: grid; place-items: center;
      background: var(--fundo-alto); color: var(--tinta);
      border: 1px solid var(--borda); cursor: pointer;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
      transition: transform 400ms var(--respiro);
    }
    #abrir-mapa:hover { transform: translateY(-2px); }

    #gaveta-mapa {
      position: fixed; inset: 0; z-index: 55;
      background: color-mix(in srgb, var(--fundo) 92%, transparent);
      padding: 3rem 1rem 1rem;
      overflow-y: auto;
      opacity: 0; transition: opacity 500ms var(--respiro);
    }
    #gaveta-mapa.aberta { opacity: 1; }
    #gaveta-mapa .mapa { max-width: 34rem; margin: 0 auto; }
    .fechar-gaveta {
      position: absolute; top: 0.9rem; right: 1rem;
      background: none; border: 0; color: var(--tinta-fraca); font-size: 1.1rem; cursor: pointer;
    }
  </style>
</Base>
