---
import '../estilos/global.css';
interface Props { titulo: string; descricao?: string; barra?: boolean }
const { titulo, descricao = 'Leitura semanal no mapa da Casa do Cais.', barra = true } = Astro.props;
const rota = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#14120f" />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="icon" href={`${base}/icone.svg`} type="image/svg+xml" />
    <title>{titulo}</title>
    <script is:inline>
      /* tema antes da primeira pintura, pra não piscar branco na cara de ninguém */
      try {
        document.documentElement.dataset.tema = localStorage.getItem('cais:tema') || 'claro';
        var f = localStorage.getItem('cais:fonte');
        if (f) document.documentElement.style.setProperty('--tamanho-leitura', f + 'px');
      } catch (e) {}
    </script>
  </head>
  <body>
    {barra && (
      <nav class="barra">
        <a class="marca" href={`${base}/`}>A Casa do Cais</a>
        <a href={`${base}/capitulos`} aria-current={rota.startsWith(`${base}/capitulo`) ? 'page' : undefined}>capítulos</a>
        <a href={`${base}/linha-do-tempo`} aria-current={rota === `${base}/linha-do-tempo` ? 'page' : undefined}>tempo</a>
        <a href={`${base}/glossario`} aria-current={rota === `${base}/glossario` ? 'page' : undefined}>glossário</a>
        <a href={`${base}/estado`} aria-current={rota === `${base}/estado` ? 'page' : undefined}>estado</a>
      </nav>
    )}
    <slot />
    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        addEventListener('load', () => navigator.serviceWorker.register(base + '/sw.js', { scope: base + '/' }).catch(() => {}));
      }
    </script>
    <footer>
      <p>O mapa só sabe anotar o que já terminou de acontecer.</p>
    </footer>
    <style is:global>
      footer {
        margin: 4rem auto 2.5rem;
        max-width: 46rem;
        padding: 1.4rem 1.25rem 0;
        border-top: 1px solid var(--borda);
        color: var(--tinta-fraca);
        font-size: 0.78rem;
        font-style: italic;
      }
    </style>
  </body>
</html>
