---
import '../estilos/global.css';
import { u, semBase } from '../dados/rota';
interface Props { titulo: string; descricao?: string; barra?: boolean }
const { titulo, descricao = 'Leitura semanal no mapa da Casa do Cais.', barra = true } = Astro.props;
const rota = semBase(Astro.url.pathname);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#14120f" />
    <link rel="manifest" href={u("/manifest.webmanifest")} />
    <link rel="icon" href={u("/icone.svg")} type="image/svg+xml" />
    <title>{titulo}</title>
    <script is:inline>
      /* tema antes da primeira pintura, pra não piscar branco na cara de ninguém */
      try {
        document.documentElement.dataset.tema = localStorage.getItem('cais:tema') || 'claro';
        var f = localStorage.getItem('cais:fonte');
        if (f) document.documentElement.style.setProperty('--tamanho-leitura', f + 'px');
      } catch (e) {}
    </script>
  </head>
  <body>
    {barra && (
      <nav class="barra">
        <a class="marca" href={u("/")}>A Casa do Cais</a>
        <a href={u("/capitulos")} aria-current={rota.startsWith('/capitulo') ? 'page' : undefined}>capítulos</a>
        <a href={u("/linha-do-tempo")} aria-current={rota === '/linha-do-tempo' ? 'page' : undefined}>tempo</a>
        <a href={u("/glossario")} aria-current={rota === '/glossario' ? 'page' : undefined}>glossário</a>
        <a href={u("/estado")} aria-current={rota === '/estado' ? 'page' : undefined}>estado</a>
      </nav>
    )}
    <slot />
    <script is:inline define:vars={{ SW: u('/sw.js') }}>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        addEventListener('load', () => navigator.serviceWorker.register(SW).catch(() => {}));
      }
    </script>
    <footer>
      <p>O mapa só sabe anotar o que já terminou de acontecer.</p>
    </footer>
    <style is:global>
      footer {
        margin: 4rem auto 2.5rem;
        max-width: 46rem;
        padding: 1.4rem 1.25rem 0;
        border-top: 1px solid var(--borda);
        color: var(--tinta-fraca);
        font-size: 0.78rem;
        font-style: italic;
      }
    </style>
  </body>
</html>
